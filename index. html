<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>

  <title>카카오맵 장소 검색 서비스</title>

  <style>
    /* 전체 기본 설정 */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      width: 100%;
      height: 100vh;
      overflow: hidden;
      font-family: Arial, sans-serif;
    }

    /* 화면 전체 2분할 */
    .container {
      display: flex;
      width: 100%;
      height: 100vh;
    }

    /* 왼쪽 검색 영역 */
    .sidebar {
      width: 35%;
      min-width: 320px;
      border-right: 1px solid #dddddd;
      display: flex;
      flex-direction: column;
      background-color: #ffffff;
    }

    /* 검색창 영역 */
    .search-section {
      padding: 20px;
      border-bottom: 1px solid #eeeeee;
    }

    .search-box {
      display: flex;
      gap: 10px;
    }

    .search-box input {
      flex: 1;
      padding: 12px;
      border: 1px solid #cccccc;
      border-radius: 8px;
      font-size: 16px;
    }

    .search-box button {
      padding: 12px 18px;
      border: none;
      border-radius: 8px;
      background-color: #FEE500;
      cursor: pointer;
      font-weight: bold;
    }

    .search-box button:hover {
      opacity: 0.9;
    }

    /* 검색 결과 리스트 */
    .result-list {
      flex: 1;
      overflow-y: auto;
    }

    .place-item {
      padding: 16px;
      border-bottom: 1px solid #f0f0f0;
      cursor: pointer;
    }

    .place-item:hover {
      background-color: #fafafa;
    }

    .place-name {
      font-size: 17px;
      font-weight: bold;
      margin-bottom: 6px;
    }

    .place-address {
      font-size: 14px;
      color: #666666;
    }

    /* 오른쪽 지도 */
    #map {
      flex: 1;
      height: 100vh;
    }
  </style>
</head>

<body>

  <div class="container">

    <!-- 왼쪽 검색 영역 -->
    <div class="sidebar">

      <!-- 검색창 -->
      <div class="search-section">

        <div class="search-box">

          <input
            type="text"
            id="keyword"
            placeholder="장소를 검색하세요"
          />

          <button onclick="searchPlaces()">
            검색
          </button>

        </div>

      </div>

      <!-- 검색 결과 -->
      <div
        class="result-list"
        id="resultList">
      </div>

    </div>

    <!-- 오른쪽 지도 -->
    <div id="map"></div>

  </div>

  <!-- 카카오맵 SDK -->
  <!-- appkey 부분에 본인의 JavaScript 키 입력 -->
  <script
    src="https://dapi.kakao.com/v2/maps/sdk.js?appkey=7945696eb2910ab4621433b26ffef270&libraries=services&autoload=false">
  </script>

  <script>

    // 지도 객체
    let map;

    // 장소 검색 서비스 객체
    let placesService;

    // 현재 위치 마커
    let currentMarker;

    // 검색 마커 저장 배열
    let markerList = [];

    // 기본 위치 (서울 시청)
    let currentLat = 37.5665;
    let currentLng = 126.9780;

    // 카카오맵 SDK가 완전히 로드된 후 실행
    kakao.maps.load(() => {

      // 브라우저 위치 권한 요청
      navigator.geolocation.getCurrentPosition(

        // 위치 권한 허용 성공
        (position) => {

          currentLat = position.coords.latitude;
          currentLng = position.coords.longitude;

          initializeMap();
        },

        // 위치 권한 거부 또는 실패
        (error) => {

          console.log("위치 권한 실패:", error);

          // 기본 위치로 지도 실행
          initializeMap();
        }
      );
    });

    // 지도 생성 함수
    function initializeMap() {

      const mapContainer =
        document.getElementById("map");

      const mapOption = {

        // 현재 위치 중심 설정
        center: new kakao.maps.LatLng(
          currentLat,
          currentLng
        ),

        // 확대 레벨
        level: 5
      };

      // 지도 생성
      map = new kakao.maps.Map(
        mapContainer,
        mapOption
      );

      // 장소 검색 서비스 생성
      placesService =
        new kakao.maps.services.Places();

      // 현재 위치 표시
      showCurrentLocation();
    }

    // 현재 위치 마커 표시 함수
    function showCurrentLocation() {

      const currentPosition =
        new kakao.maps.LatLng(
          currentLat,
          currentLng
        );

      // 현재 위치 마커 생성
      currentMarker =
        new kakao.maps.Marker({

          map: map,
          position: currentPosition
        });

      // 현재 위치 인포윈도우 생성
      const infoWindow =
        new kakao.maps.InfoWindow({

          content: `
            <div style="padding:8px; font-size:13px;">
              현재 위치
            </div>
          `
        });

      // 인포윈도우 열기
      infoWindow.open(
        map,
        currentMarker
      );
    }

    // 장소 검색 함수
    function searchPlaces() {

      const keywordInput =
        document.getElementById("keyword");

      const keyword =
        keywordInput.value.trim();

      // 검색어가 없으면 종료
      if (!keyword) {

        alert("검색어를 입력하세요.");

        return;
      }

      // 현재 위치 기준으로 검색
      placesService.keywordSearch(

        keyword,

        placesSearchCallback,

        {
          location: new kakao.maps.LatLng(
            currentLat,
            currentLng
          )
        }
      );
    }

    // 검색 결과 처리 함수
    function placesSearchCallback(
      data,
      status
    ) {

      // 검색 실패 처리
      if (
        status !==
        kakao.maps.services.Status.OK
      ) {

        alert("검색 결과가 없습니다.");

        return;
      }

      // 기존 마커 제거
      removeMarkers();

      // 검색 결과 리스트 초기화
      const resultList =
        document.getElementById("resultList");

      resultList.innerHTML = "";

      // 지도 범위 객체 생성
      const bounds =
        new kakao.maps.LatLngBounds();

      // 검색 결과 반복
      data.forEach((place) => {

        const position =
          new kakao.maps.LatLng(
            place.y,
            place.x
          );

        // 마커 생성
        const marker =
          new kakao.maps.Marker({

            map: map,
            position: position
          });

        // 배열에 저장
        markerList.push(marker);

        // 지도 범위 추가
        bounds.extend(position);

        // 인포윈도우 생성
        const infoWindow =
          new kakao.maps.InfoWindow({

            content: `
              <div style="padding:8px; font-size:13px;">
                ${place.place_name}
              </div>
            `
          });

        // 마커 클릭 이벤트
        kakao.maps.event.addListener(
          marker,
          "click",
          () => {

            infoWindow.open(
              map,
              marker
            );
          }
        );

        // 검색 결과 아이템 생성
        const item =
          document.createElement("div");

        item.className = "place-item";

        item.innerHTML = `

          <div class="place-name">
            ${place.place_name}
          </div>

          <div class="place-address">
            ${place.road_address_name || place.address_name}
          </div>

        `;

        // 검색 결과 클릭 시 지도 이동
        item.addEventListener(
          "click",
          () => {

            map.setCenter(position);

            infoWindow.open(
              map,
              marker
            );
          }
        );

        // 결과 리스트에 추가
        resultList.appendChild(item);
      });

      // 검색 결과가 모두 보이게 지도 범위 조정
      map.setBounds(bounds);
    }

    // 기존 마커 제거 함수
    function removeMarkers() {

      markerList.forEach((marker) => {

        marker.setMap(null);
      });

      markerList = [];
    }

  </script>

</body>
</html>
